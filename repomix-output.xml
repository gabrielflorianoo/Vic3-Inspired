<file path="src/ui/panels/panel_base.gd">
extends VBoxContainer
## Base class for tab panels. `hud` is the GameHud (provides state, world,
## toast(), selection helpers). Panels rebuild their children in `rebuild()`;
## `refresh()` is called by the HUD on the weekly tick (throttled) or after a
## user action — never every frame.

const K := preload("res://src/ui/ui_kit.gd")

var hud: Control
var state: RefCounted
var world: RefCounted
var player := 0


func setup(h: Control) -> void:
	hud = h
	state = h.state
	world = h.world
	player = state.player
	add_theme_constant_override("separation", 8)
	size_flags_horizontal = Control.SIZE_EXPAND_FILL
	refresh()


func refresh() -> void:
	K.clear(self)
	rebuild()


func rebuild() -> void:
	pass


## Run an action that returns {ok, reason} (or bool) and toast the outcome.
func act(res: Variant, ok_msg: String, then_refresh := true) -> void:
	hud.toast(K.result_text(res, ok_msg), "ok" if K.result_ok(res) else "error")
	if then_refresh:
		hud.refresh_now()


## Read a constant from a sim module instance (e.g. PROF_NAMES).
func const_of(obj: Object, const_name: String, default: Variant) -> Variant:
	var scr: Script = obj.get_script()
	return scr.get_script_constant_map().get(const_name, default) if scr != null else default


func name_of(c: int) -> String:
	return world.c_name[c] if c >= 0 and c < world.country_count else "?"


func short_of(c: int) -> String:
	return world.c_short[c] if c >= 0 and c < world.country_count else "?"


func country_chip(c: int, fs := 13) -> Control:
	var h := K.hbox(6)
	h.add_child(K.flag(world.c_color[c], Vector2(18, 12)))
	h.add_child(K.lbl(short_of(c), fs))
	return h


## Wars of the player with warscore + peace buttons. Shared by Diplomacy and Military.
func war_rows(parent: Control) -> void:
	var wars: Array = state.diplo.wars_of(player)
	if wars.is_empty():
		parent.add_child(K.lbl("At peace.", 13, K.DIM))
		return
	for w: Dictionary in wars:
		var att: Array = w.get("attackers", [])
		var is_att: bool = att.has(player)
		var foes: Array = w.get("defenders", []) if is_att else att
		var score: float = state.diplo.warscore_for(w, player)
		var names: PackedStringArray = []
		for f in foes:
			names.append(short_of(int(f)))
		var box := K.vbox(3)
		var head := K.hbox(8)
		var summary: String = state.diplo.war_summary(int(w.get("id", 0)))
		head.add_child(K.lbl("%s vs %s" % [state.diplo.war_name(w), ", ".join(names)], 14, K.BAD, summary))
		head.add_child(K.spacer())
		head.add_child(K.lbl("%s  -  %d days" % ["Attacker" if is_att else "Defender", state.day - int(w.get("start_day", 0))], 11, K.DIM, summary))
		box.add_child(head)
		var row := K.hbox(8)
		row.add_child(K.lbl("Warscore %+d" % int(score), 13, K.sign_color(score),
			"Positive means you are winning. Offers are accepted more readily when the enemy's warscore against them is poor."))
		var b := K.bar((score + 100.0) / 200.0, K.GOOD if score >= 0.0 else K.BAD, 160.0, 10.0)
		row.add_child(b)
		box.add_child(row)
		var pr := K.hbox(6)
		var wid: int = int(w.get("id", 0))
		pr.add_child(K.btn("White peace", "Offer to end the war with no changes", func(): act(state.diplo.offer_peace(wid, player, "white_peace"), "Peace agreed.")))
		pr.add_child(K.btn("Peace: cede war goals", "Offer peace on the terms of the war goals", func(): act(state.diplo.offer_peace(wid, player, "cede_goals"), "Peace agreed.")))
		box.add_child(pr)
		box.add_child(HSeparator.new())
		parent.add_child(box)
</file>

<file path="src/ui/panels/pause_menu.gd">
extends Control
## Esc menu: Resume, Save, Load, Settings, Main Menu, Quit. Sub-dialogs replace
## the button column in place. Main Menu / Quit ask for confirmation.

signal resume_requested
signal setting_changed(key: String)
signal toast_requested(text: String, kind: String)

const K := preload("res://src/ui/ui_kit.gd")
const SettingsScreen := preload("res://src/ui/settings_screen.gd")
const SaveLoadDialog := preload("res://src/ui/panels/save_load_dialog.gd")

var state: RefCounted
var _center: CenterContainer
var _main_box: PanelContainer


func setup(s: RefCounted) -> void:
	state = s
	theme = K.get_theme()
	set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	var dim := ColorRect.new()
	dim.color = Color(0, 0, 0, 0.58)
	dim.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	add_child(dim)
	_center = CenterContainer.new()
	_center.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	_center.mouse_filter = Control.MOUSE_FILTER_IGNORE
	add_child(_center)
	visible = false


func open() -> void:
	visible = true
	_show_main()


func close() -> void:
	visible = false
	_clear()


func _clear() -> void:
	for c in _center.get_children():
		_center.remove_child(c)
		c.queue_free()


func _show_main() -> void:
	_clear()
	var p := PanelContainer.new()
	p.add_theme_stylebox_override("panel", K.style(Color(0.10, 0.09, 0.075, 0.98), K.BORDER, 2, 4, 20))
	_center.add_child(p)
	var v := K.vbox(8)
	v.custom_minimum_size = Vector2(280, 0)
	p.add_child(v)
	var t := K.lbl("PAUSED", 24, K.GOLD)
	t.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	v.add_child(t)
	var d := K.lbl(state.date_string(), 13, K.DIM)
	d.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	v.add_child(d)
	v.add_child(HSeparator.new())
	_add(v, "Resume", "Back to the game (Esc)", func(): resume_requested.emit())
	_add(v, "Save Game", "Write a save file", _show_save)
	_add(v, "Load Game", "Load a saved game", _show_load)
	_add(v, "Settings", "Display and gameplay options", _show_settings)
	_add(v, "Main Menu", "Leave this game", func(): _confirm("Return to the main menu? Unsaved progress will be lost.", func(): K.session().to_menu()))
	_add(v, "Quit", "Exit to desktop", func(): _confirm("Quit to desktop? Unsaved progress will be lost.", func(): K.session().quit_game()))


func _add(parent: Control, text: String, tip: String, cb: Callable) -> void:
	var b := K.btn(text, tip, cb)
	b.custom_minimum_size = Vector2(0, 38)
	b.add_theme_font_size_override("font_size", 16)
	parent.add_child(b)


func _confirm(msg: String, yes: Callable) -> void:
	_clear()
	var p := PanelContainer.new()
	_center.add_child(p)
	var v := K.vbox(10)
	p.add_child(v)
	var l := K.lbl(msg, 14)
	l.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	l.custom_minimum_size = Vector2(320, 0)
	v.add_child(l)
	var h := K.hbox(8)
	h.add_child(K.btn("Yes", "", yes))
	h.add_child(K.btn("Cancel", "", _show_main))
	v.add_child(h)


func _show_save() -> void:
	_clear()
	var d := SaveLoadDialog.new()
	d.setup("save")
	d.closed.connect(_show_main)
	d.save_requested.connect(func(n):
		var path: String = K.session().save_game(state, n)
		toast_requested.emit(("Saved: " + n) if path != "" else "Saving failed", "ok" if path != "" else "error")
		resume_requested.emit())
	_center.add_child(d)


func _show_load() -> void:
	_clear()
	var d := SaveLoadDialog.new()
	d.setup("load")
	d.closed.connect(_show_main)
	d.load_requested.connect(func(p): K.session().start_load(p))
	_center.add_child(d)


func _show_settings() -> void:
	_clear()
	var s := SettingsScreen.new()
	s.closed.connect(_show_main)
	s.changed.connect(func(k): setting_changed.emit(k))
	_center.add_child(s)
</file>

<file path="src/ui/panels/politics.gd">
extends "res://src/ui/panels/panel_base.gd"
## Politics: legitimacy, interest groups (clout, approval + breakdown tooltips),
## laws per category with Enact buttons, and the enactment in progress.


func rebuild() -> void:
	var c := player
	var pol = state.politics
	var leg: float = pol.legitimacy(c)
	var head := K.hbox(10)
	head.add_child(K.lbl("Government: %s" % (pol.government_name(c) if pol.government_name(c) != "" else world.c_gov[c]), 16, K.GOLD))
	head.add_child(K.spacer())
	add_child(head)
	var lr := K.hbox(8)
	lr.add_child(K.lbl("Legitimacy %d" % int(leg), 13, K.INK, "Falls with debt, unrest and war exhaustion. Low legitimacy invites revolution."))
	lr.add_child(K.bar(leg / 100.0, K.GOOD if leg >= 50.0 else (K.WARN if leg >= 25.0 else K.BAD), 200.0, 10.0))
	lr.add_child(K.lbl("Unrest %s" % K.pct(pol.unrest(c)), 12, K.BAD if pol.unrest(c) > 0.25 else K.DIM, "Share of the population that is radical."))
	add_child(lr)

	add_child(K.section("Interest groups"))
	var g := K.grid(5, 14, 5)
	for h in ["Group", "Clout", "", "Approval", ""]:
		g.add_child(K.lbl(h, 12, K.GOLD))
	for i in pol.ig_count():
		var ap: float = pol.approval(c, i)
		var tip: String = K.breakdown_text("%s approval of the government" % pol.ig_name(i), pol.approval_breakdown(c, i))
		var in_gov: bool = pol.in_government(c, i)
		var nm := HBoxContainer.new()
		nm.add_theme_constant_override("separation", 6)
		nm.add_child(K.flag(pol.ig_color(i), Vector2(10, 10)))
		nm.add_child(K.lbl(pol.ig_name(i) + ("  *" if in_gov else ""), 13, K.INK, tip + ("\n\n* In government" if in_gov else "")))
		nm.mouse_filter = Control.MOUSE_FILTER_PASS
		g.add_child(nm)
		var clout: float = pol.clout(c, i)
		g.add_child(K.lbl(K.pct(clout, 1), 13, K.INK, "Share of political strength: population x wealth x literacy x suffrage."))
		g.add_child(K.bar(clout, pol.ig_color(i), 70.0, 8.0))
		g.add_child(K.lbl("%+.1f" % ap, 13, K.sign_color(ap), tip))
		g.add_child(K.bar((ap + 10.0) / 20.0, K.GOOD if ap >= 0.0 else K.BAD, 70.0, 8.0, tip))
	add_child(g)
	add_child(K.lbl("* governing groups", 11, K.DIM))

	var st: Dictionary = pol.enact_status(c)
	var active_cat: String = str(st.get("cat", ""))
	if active_cat != "":
		add_child(K.section("Being enacted"))
		var row := K.hbox(8)
		row.add_child(K.lbl("%s: %s" % [pol.category_name(active_cat), pol.option_name(active_cat, str(st.get("opt", "")))], 13, K.WARN))
		row.add_child(K.bar(float(st.get("progress", 0.0)), K.GOLD, 120.0, 10.0))
		row.add_child(K.lbl("support %s  -  %s / month" % [K.pct(float(st.get("support", 0.0))), K.pct(float(st.get("chance", 0.0)))], 12, K.DIM,
			"Each month the reform succeeds with a chance based on the clout of groups that approve of it."))
		row.add_child(K.btn("Cancel", "Abandon this reform", func():
			pol.cancel_enact(c)
			hud.refresh_now()))
		add_child(row)

	add_child(K.section("Laws"))
	for cat: String in pol.categories():
		var cur: String = pol.law(c, cat)
		var box := K.hbox(6)
		var cl := K.lbl(pol.category_name(cat), 13, K.GOLD)
		cl.custom_minimum_size = Vector2(96, 0)
		box.add_child(cl)
		var fl := HFlowContainer.new()
		fl.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		fl.add_theme_constant_override("h_separation", 5)
		fl.add_theme_constant_override("v_separation", 4)
		for o in pol.options(cat):
			var opt: String = str(o["id"]) if o is Dictionary else str(o)
			var oname: String = pol.option_name(cat, opt)
			var odesc: String = str(o.get("desc", "")) if o is Dictionary else ""
			if o is Dictionary and o.get("modifiers") is Dictionary and not o["modifiers"].is_empty():
				var parts: PackedStringArray = []
				for mk: String in o["modifiers"]:
					parts.append("%s %+.2f" % [mk.replace("_", " "), float(o["modifiers"][mk])])
				odesc += "\n" + ", ".join(parts)
			if opt == cur:
				var cb := K.btn(oname + " (current)", odesc, Callable(), false)
				cb.disabled = true
				cb.add_theme_color_override("font_disabled_color", K.GOOD)
				fl.add_child(cb)
				continue
			var res: Dictionary = pol.can_enact(c, cat, opt)
			var ok: bool = bool(res.get("ok", false))
			fl.add_child(K.btn(oname, (odesc + "\n\nBegin enacting this law.") if ok else (odesc + "\n\n" + str(res.get("reason", ""))),
				func(): act(pol.start_enact(c, cat, opt), "Began enacting %s." % oname), ok))
		box.add_child(fl)
		add_child(box)
