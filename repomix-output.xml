<file path="src/game/game_controller.gd">
extends Node
## Owns the running GameState: speed control and time-sliced stepping.
##
## Speeds (days per real second): 0 pause, 1, 3, 8, 20, MAX. Simulation work
## per frame is capped at BUDGET_MS so the UI stays responsive; unspent day
## credit carries over (capped) instead of being dropped. The UI is told once
## per frame via `stepped`, never once per simulated day.

signal stepped(days: int, week: bool, month: bool)
signal speed_changed(speed: int)
signal events_arrived(events: Array)
signal player_eliminated

const Settings := preload("res://src/game/settings.gd")
const BUDGET_MS := 5.0
const DAYS_PER_SEC := [0.0, 1.0, 3.0, 8.0, 20.0, 55.0]
const SPEED_NAMES := ["Paused", "Speed 1 (1 day/s)", "Speed 2 (3 days/s)", "Speed 3 (8 days/s)", "Speed 4 (20 days/s)", "Speed 5 (55 days/s)"]
const MAX_CARRY := 7.0

var state: RefCounted
var speed := 0
var last_speed := 1
var blocked := false         # true while a modal (pause menu) is open
var sim_ms_last := 0.0       # sim time spent in the last stepping frame
var _credit := 0.0
var _eliminated := false
var _last_autosave_msec := -60000


func setup(s: RefCounted) -> void:
	state = s
	set_process(true)


func set_speed(v: int) -> void:
	v = clampi(v, 0, DAYS_PER_SEC.size() - 1)
	if v == speed:
		return
	speed = v
	if v > 0:
		last_speed = v
	_credit = 0.0
	speed_changed.emit(speed)


func toggle_pause() -> void:
	set_speed(last_speed if speed == 0 else 0)


func _process(delta: float) -> void:
	if state == null or speed == 0 or blocked or _eliminated:
		return
	_credit = minf(_credit + DAYS_PER_SEC[speed] * delta, MAX_CARRY)
	var t0 := Time.get_ticks_usec()
	var days := 0
	var week := false
	var month := false
	while _credit >= 1.0:
		# If we already stepped at least one day this frame and the upcoming day is a heavy
		# weekly or monthly tick, defer it to the next frame so plain days + heavy ticks don't stack.
		if days > 0:
			var next_day: int = state.day + 1
			var next_doy: int = next_day % state.DAYS_PER_YEAR
			if (next_day % 7 == 0) or (state._dom_of_doy[next_doy] == 1):
				break
		state.advance_day()
		_credit -= 1.0
		days += 1
		var heavy := false
		if state.day % 7 == 0:
			week = true
			heavy = true
		if state.day_of_month() == 1:
			month = true
			heavy = true
			_maybe_autosave()
		# A weekly/monthly tick is atomic, so never run a second one in the same
		# frame: stop right after the first, even if the time budget is not yet spent.
		if heavy or (Time.get_ticks_usec() - t0) / 1000.0 >= BUDGET_MS:
			break
	sim_ms_last = (Time.get_ticks_usec() - t0) / 1000.0
	if days == 0:
		return
	stepped.emit(days, week, month)
	var evs: Array = state.take_new_events()
	if not evs.is_empty():
		events_arrived.emit(evs)
	if state.alive[state.player] == 0:
		_eliminated = true
		set_speed(0)
		player_eliminated.emit()


func _maybe_autosave() -> void:
	var mode := int(Settings.get_value("autosave"))
	if mode == 0:
		return
	if mode == 2 and state.month() != 1:
		return
	var now := Time.get_ticks_msec()
	# At high speeds (e.g. x4/x5), a simulated month passes in ~0.2-1.5 seconds;
	# throttle disk writes to at most once every 15 real seconds unless it's January in yearly mode.
	if mode == 1 and now - _last_autosave_msec < 15000:
		return
	_last_autosave_msec = now
	_session().save_game(state, "autosave")


func _session() -> Node:
	return (Engine.get_main_loop() as SceneTree).root.get_node("Session")
</file>

<file path="src/map/map_view.gd">
extends Sprite2D
## The world map: one textured quad drawn with map.gdshader.
## Per-province visual state is pushed into a (N x 2) lookup texture only when
## selection, hover or ownership changes — never per frame.

enum Mode { POLITICAL, TERRAIN, PROVINCES, SOL, POPULATION, GDP, RADICALS }

var world: RefCounted
var mode: int = Mode.POLITICAL
var selected_province := 0
var selected_country := -1
var hovered_province := 0
## Optional (province:int) -> controlling country. Differs from the owner while
## a province is occupied; those provinces are drawn with diagonal stripes.
var controller_fn := Callable()
## Optional (province:int, mode:int) -> Color for heatmap lenses (modes >= 3).
var lens_color_fn := Callable()

var _lookup_img: Image
var _lookup_tex: ImageTexture
var _mat: ShaderMaterial
var _any_occupied := false
var _last_zoom := -1.0


func setup(w: RefCounted) -> void:
	world = w
	centered = false
	var terrain: Image = world.terrain_image.duplicate()
	terrain.generate_mipmaps()
	texture = ImageTexture.create_from_image(terrain)
	_mat = ShaderMaterial.new()
	_mat.shader = preload("res://src/map/map.gdshader")
	_mat.set_shader_parameter("terrain_tex", texture)
	_mat.set_shader_parameter("id_tex", ImageTexture.create_from_image(world.id_image))
	_mat.set_shader_parameter("map_size", Vector2(world.width, world.height))
	material = _mat
	_lookup_img = Image.create(world.province_count, 3, false, Image.FORMAT_RGBA8)
	_lookup_tex = ImageTexture.create_from_image(_lookup_img)
	_mat.set_shader_parameter("lookup_tex", _lookup_tex)
	refresh_all()


func refresh_all() -> void:
	_any_occupied = false
	for id in world.province_count:
		_write(id)
	_mat.set_shader_parameter("has_occupation", _any_occupied)
	_lookup_tex.update(_lookup_img)
	_mat.set_shader_parameter("country_selected", selected_country >= 0)
	_mat.set_shader_parameter("map_mode", mode)


func _write(id: int) -> void:
	var o: int = world.p_owner[id] if id > 0 else -1
	var c := Color(0, 0, 0, 0)
	if o >= 0:
		if mode >= Mode.SOL and lens_color_fn.is_valid():
			c = lens_color_fn.call(id, mode)
			c.a = 1.0
		else:
			c = world.c_color[o]
			c.a = 1.0
	_lookup_img.set_pixel(id, 0, c)
	_lookup_img.set_pixel(id, 1, Color8(o + 1, 255 if id == selected_province and id > 0 else 0,
		255 if id == hovered_province and id > 0 else 0, 255 if o >= 0 and o == selected_country else 0))
	# Row 2: occupation. rgb = occupier colour, a = 1 when controlled by someone else.
	var occ := Color(0, 0, 0, 0)
	if controller_fn.is_valid() and o >= 0:
		var ctl: int = controller_fn.call(id)
		if ctl >= 0 and ctl != o:
			occ = world.c_color[ctl]
			occ.a = 1.0
			_any_occupied = true
	_lookup_img.set_pixel(id, 2, occ)


func _write_meta(id: int) -> void:
	var o: int = world.p_owner[id] if id > 0 else -1
	_lookup_img.set_pixel(id, 1, Color8(o + 1, 255 if id == selected_province and id > 0 else 0,
		255 if id == hovered_province and id > 0 else 0, 255 if o >= 0 and o == selected_country else 0))


func set_mode(m: int) -> void:
	var was_lens := mode >= Mode.SOL
	var is_lens := m >= Mode.SOL
	mode = m
	if was_lens or is_lens:
		refresh_all()
	else:
		_mat.set_shader_parameter("map_mode", mode)


func set_zoom(z: float) -> void:
	if z == _last_zoom:
		return
	_last_zoom = z
	_mat.set_shader_parameter("zoom", z)


func set_detail(on: bool) -> void:
	_mat.set_shader_parameter("detail", 1.0 if on else 0.0)


func select(province: int) -> void:
	var country: int = world.p_owner[province] if province > 0 else -1
	var old_p := selected_province
	var old_c := selected_country
	selected_province = province
	selected_country = country
	if country != old_c:
		if old_c >= 0 and old_c < world.c_provinces.size():
			for p: int in world.c_provinces[old_c]:
				_write_meta(p)
		if country >= 0 and country < world.c_provinces.size():
			for p: int in world.c_provinces[country]:
				_write_meta(p)
		_write_meta(old_p)
		_write_meta(province)
		_mat.set_shader_parameter("country_selected", selected_country >= 0)
		_lookup_tex.update(_lookup_img)
		return
	_write_meta(old_p)
	_write_meta(province)
	_lookup_tex.update(_lookup_img)


func select_country(country: int) -> void:
	var cap: int = world.c_capital[country] if country >= 0 else 0
	select(cap)


func set_hover(province: int) -> void:
	if province == hovered_province:
		return
	var old := hovered_province
	hovered_province = province
	_write_meta(old)
	_write_meta(province)
	_lookup_tex.update(_lookup_img)
