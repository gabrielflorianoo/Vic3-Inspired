; Engine configuration file.
; Iron & Society — targets Godot 4.3, Compatibility (OpenGL 3.3 / GLES3) renderer.

config_version=5

[application]

config/name="Iron & Society"
config/description="Performance-first historical grand strategy."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="disabled"
window/vsync/vsync_mode=1

[input_devices]

pointing/emulate_touch_from_mouse=false

[physics]

common/physics_ticks_per_second=30

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=false
environment/defaults/default_clear_color=Color(0.09, 0.13, 0.18, 1)
anti_aliasing/quality/msaa_2d=0
2d/snap/snap_2d_transforms_to_pixel=false
